# Copier en .env et remplir. Ne jamais versionner .env.
DJANGO_DEBUG=False
DJANGO_SECRET_KEY=à-générer
DJANGO_ALLOWED_HOSTS=ajc06.com,www.ajc06.com
DJANGO_CSRF_TRUSTED_ORIGINS=https://ajc06.com,https://www.ajc06.com
SITE_URL=https://ajc06.com
SECURE_SSL_REDIRECT=True
# True seulement derrière un reverse proxy qui pose X-Forwarded-For (Caddy/Docker) ; False sur o2switch
TRUST_X_FORWARDED_FOR=False

# Données hors du dossier du code
DATABASE_PATH=/chemin/vers/db.sqlite3
MEDIA_ROOT=/chemin/vers/media
BACKUP_DIR=/chemin/vers/backups

# Courriels : contact, mot de passe oublié, confirmation d'inscription
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.exemple.fr
EMAIL_PORT=587
# Port 465 : EMAIL_USE_SSL=True ; port 587 : STARTTLS par défaut
EMAIL_USE_SSL=False
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=AJC06 <no-reply@ajc06.com>
CONTACT_EMAIL=contact@ajc06.com
# Validation des nouveaux comptes : aucune, bureau (à la main dans /gestion/comptes/) ou courriel (une fois le SMTP vérifié)
ACCOUNT_VALIDATION=bureau

# Mentions légales : hébergeur réel du site
LEGAL_HOST=Nom de l'hébergeur, adresse postale, téléphone

# HelloAsso : nombre d inscrit·es (python manage.py sync_helloasso, à lancer toutes les heures)
HELLOASSO_CLIENT_ID=
HELLOASSO_CLIENT_SECRET=
